<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vn.s2s.robotclient">

    <!-- Nối WebSocket tới server s2s-vn trên máy LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- CẢNH BÁO: từ API 23 đây là runtime permission — khai ở đây KHÔNG đủ,
         phải gọi requestPermissions(). Quên thì AudioRecord trả buffer toàn số 0
         mà không ném exception, trùng đúng triệu chứng "bị chiếm mic". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="s2s-vn Robot Client"
        android:supportsRtl="true" />

</manifest>
