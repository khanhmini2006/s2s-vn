<?xml version="1.0" encoding="utf-8"?>
<!--
  Nền nút nói. Ba trạng thái đọc được từ xa mà không cần đọc chữ:
  xám = chưa dùng được · ngọc = sẵn sàng · hổ phách = đang nghe (nút được chọn).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/muc_nhat" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Đang nghe: Activity bật selected khi mở mic. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ho_phach" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2AA294" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ngoc" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</selector>
